{
  "name": "eureka-js-client",
  "version": "4.5.0",
  "description": "A JavaScript implementation the Netflix OSS service registry, Eureka.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "prepublishOnly": "gulp",
    "test": "gulp test",
    "integration": "gulp test:integration",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:integration:vitest": "vitest run --config=vitest.integration.config.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jquatier/eureka-js-client.git"
  },
  "keywords": [
